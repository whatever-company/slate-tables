{
  "name": "@whatever-company/slate-tables",
  "version": "1.3.2",
  "description": "A Slate plugin to handle table edition",
  "type": "module",
  "sideEffects": false,
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "lib",
    "*.md"
  ],
  "peerDependencies": {
    "slate": "^0.47.8"
  },
  "dependencies": {
    "is-hotkey": "0.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.11",
    "@types/react": "^16.14.70",
    "react": "16.14.0",
    "react-dom": "16.14.0",
    "react-test-renderer": "16.13.1",
    "slate": "^0.47.8",
    "slate-hyperscript": "^0.13.8",
    "slate-react": "npm:druide-slate-react",
    "standard-version": "9.5.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.8",
    "vitest": "4.1.4"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.declarations.json && tsc -p tsconfig.json",
    "start": "vite examples",
    "build-examples": "vite build examples --outDir ../dist-examples --emptyOutDir --base /slate-tables",
    "release": "standard-version",
    "lint": "biome check"
  },
  "repository": "git@github.com:whatever-company/slate-tables.git",
  "author": "Elium <info@elium.com>",
  "license": "MIT"
}
