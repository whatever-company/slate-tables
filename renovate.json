{
	"extends": ["github>whatever-company/renovate-config"],
	"ignoreDeps": ["slate", "slate-hyperscript", "slate-react", "slate-plain-serializer"],
	"automerge": true,
	"prConcurrentLimit": 3,
	"packageRules": [
		{
			"packageNames": ["react", "react-dom", "react-test-renderer"],
			"groupName": "React"
		},
		{
			"packageNames": ["debug"],
			"allowedVersions": "<4"
		}
	]
}
