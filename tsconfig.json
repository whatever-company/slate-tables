{
	"compilerOptions": {
		"noEmit": true,
		"strict": true,
		"target": "es2022",
		"lib": ["es2022", "dom"],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		// The plugin is plain ESM: types are hand-written next to the JS they describe
		"allowJs": true,
		"checkJs": false
	},
	"include": ["lib/**/*.d.ts", "tests/types"]
}
